{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error"
  },
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "excludeFiles": ["src/modules/accounts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/accounts/*/**"],
                "message": "Fronteira do contexto Contas: importe de modules/accounts/index.js."
              }
            ]
          }
        ]
      }
    }
  ]
}
