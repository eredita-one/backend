# Copie para .env e preencha. O .env nunca vai para o git.
# A API não sobe se faltar variável obrigatória ou se algum valor for inválido.

NODE_ENV=development
PORT=3333

# PostgreSQL. Com o docker-compose deste repo (ver README, no Windows via WSL):
DATABASE_URL="postgresql://api:api@localhost:5432/api_backend"

# Origens dos apps que podem chamar a API pelo navegador, separadas por vírgula.
# (Se o front chamar a API só do servidor Next, pode ficar vazio.)
CORS_ORIGINS="http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004"

# Atrás de proxy reverso, número de saltos confiáveis (ex.: 1). 0 = desligado.
TRUST_PROXY=0

# Swagger em /docs. Deixe false em produção.
SWAGGER_ENABLED=true

# ─── Tokens ───────────────────────────────────────────────────────────────────
# Dois segredos DIFERENTES, com pelo menos 32 caracteres cada. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ISSUER=api-backend
JWT_STAFF_SECRET=
JWT_CLIENT_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_HOURS=12
REFRESH_TOKEN_REMEMBER_DAYS=30
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10

# ─── Proteção do login ────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=10

# ─── Seed (pnpm db:seed) ──────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME="Administrador"
# Mínimo de 12 caracteres.
SEED_ADMIN_PASSWORD=
# Perfis de outros apps para o primeiro admin, além do Administrador geral (só na criação
# da conta). Ninguém altera o próprio acesso pela API, então este é o jeito de o primeiro
# admin também entrar no Consultor e no Contábil. Nomes separados por vírgula; use
# APP:Nome se o nome existir em mais de um app. Vazio = só o app admin.
SEED_ADMIN_EXTRA_PROFILES="Consultor, Commercialista"
# Só em desenvolvimento: cria consultor, contábil, gestora (admin+consultor) e cliente de demonstração.
SEED_DEMO_ACCOUNTS=false
SEED_DEMO_PASSWORD=
